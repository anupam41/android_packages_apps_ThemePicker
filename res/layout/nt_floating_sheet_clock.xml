<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="20dp"
    android:background="@drawable/floating_sheet_content_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Nothing OS Clock Picker Header -->
    <TextView
        android:id="@+id/nt_clock_picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lock Screen Clocks"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/system_on_surface"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal" />

    <!-- Horizontal Clock Carousel RecyclerView displaying Pixel / SystemUI clock plugins -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/nt_clock_style_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginBottom="16dp" />

    <!-- Nothing OS Clock Size / Axis Slider Container -->
    <LinearLayout
        android:id="@+id/nt_clock_slider_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/nt_clock_size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clock Size &amp; Format"
            android:textSize="14sp"
            android:textColor="@color/system_on_surface_variant"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/nt_clock_axis_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="100.0"
            android:value="50.0"
            app:labelBehavior="gone" />
    </LinearLayout>

</LinearLayout>
